{
  "name": "media-transcriber-server",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript API server that manages transcription jobs and supervises the speech-helper Swift binary.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "cd \"$(git rev-parse --show-toplevel)\" 2>/dev/null && git config core.hooksPath .githooks && chmod +x .githooks/pre-push || true"
  },
  "dependencies": {
    "fastify": "^5.11.2",
    "nanoid": "^3.3.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.2.7"
  },
  "bin": {
    "transcribe": "./dist/cli.js"
  }
}
